datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccommodationType {
  Hotel
  Apartment
  Villa
  VacationHome
  GuestHouse
  Hostel
  BedAndBreakfast
  Homestay
  Campground
  CountryHouse
  Boat
  LuxuryTent
  Cabin
  Motel
  Resort
  FarmStay
  CapsuleHotel
  Treehouse
  Townhouse
  Other
}

enum RentalType {
  ENTIRE_PLACE
  PRIVATE_ROOM
  SHARED_ROOM
}

model Accommodation {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(191)
  description String?            @db.Text
  type        AccommodationType?
  rentalType  RentalType?        @default(ENTIRE_PLACE)
  isActive    Boolean            @default(true)
  ownerId     String             @db.VarChar(191) // Reference to user-service

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address   Address? @relation(fields: [addressId], references: [id])
  addressId String?  @unique @db.VarChar(191)

  facilities AccommodationFacility[]

  @@index([type])
  @@index([ownerId])
  @@map("accommodations")
}

model Address {
  id         String  @id @default(uuid())
  street     String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  state      String? @db.VarChar(100)
  postalCode String? @db.VarChar(20)
  country    String  @db.VarChar(100)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation?

  @@index([city])
  @@index([postalCode])
  @@index([latitude, longitude])
  @@map("addresses")
}

model Facility {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String? @db.Text
  icon        String? @db.VarChar(255) // URL or icon name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodations AccommodationFacility[]

  @@map("facilities")
}

model AccommodationFacility {
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])
  accommodationId String        @db.VarChar(191)
  facility        Facility      @relation(fields: [facilityId], references: [id])
  facilityId      String        @db.VarChar(191)

  @@id([accommodationId, facilityId])
  @@index([facilityId])
  @@map("accommodation_facilities")
}
