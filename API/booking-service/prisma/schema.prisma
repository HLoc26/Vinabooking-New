// prisma/schema.prisma
// Booking Service Prisma schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/booking" // client output folder, specific for booking service
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // separate DB connection for booking service
}

model Booking {
  id          String        @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  guestCount  Int           @default(1)
  referenceNo Int           @unique @default(autoincrement())
  status      BookingStatus @default(BOOKED)

  // Relations
  items     BookingItem[]
  userId    String // who made the booking (traveler)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BookingItem {
  id    String  @id @default(uuid())
  count Int     @default(1)
  note  String?

  // Relations
  bookingId String
  Booking   Booking  @relation(fields: [bookingId], references: [id])
  roomId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  DRAFT
  PENDING // waiting for payment, confirmation from accommodation owner
  CANCELLED
  BOOKED // successfully paid and confirmed
  COMPLETED // stay completed, review can be left
}
