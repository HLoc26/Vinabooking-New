generator client {
    provider      = "prisma-client"
    output        = "../src/generated"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "mysql"
}

// User

enum ERole {
    Traveller
    AccommodationOwner
}

model FavouriteList {
    id      String @id @default(uuid())
    name    String
    owner   User   @relation(fields: [ownerId], references: [id])
    ownerId String

    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt
    items     FavouriteItem[]

    @@unique([name, ownerId])
}

model FavouriteItem {
    id String @id @default(uuid())

    favouriteList FavouriteList @relation(fields: [listId], references: [id], onDelete: Cascade)
    listId        String

    accommodationId String
}

model User {
    id    String  @id // Cognito sub UUIDv4
    email String  @unique
    name  String
    phone String?
    role  ERole   @default(Traveller)

    favourites FavouriteList[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//Booking
model Booking {
    id          String         @id @default(uuid())
    startDate   DateTime
    endDate     DateTime
    guestCount  Int            @default(1)
    leaderName  String?
    leaderEmail String?
    totalPrice  Decimal?       @db.Decimal(10, 2)
    phone       String?
    referenceNo Int            @unique
    status      EBookingStatus @default(BOOKED)

    // Relations
    details   BookingDetail[]
    userId    String // who made the booking (traveler)   
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt
}

model BookingDetail {
    id    String  @id @default(uuid())
    count Int     @default(1)
    note  String?

    // Relations
    bookingId String
    Booking   Booking   @relation(fields: [bookingId], references: [id])
    itemId    String // itemType
    itemType  EItemType
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

enum EBookingStatus {
    DRAFT
    PENDING // waiting for payment, confirmation from accommodation owner
    CANCELLED
    BOOKED // successfully paid and confirmed
    COMPLETED // stay completed, review can be left
}

enum EItemType {
    ROOM
    BED
}
