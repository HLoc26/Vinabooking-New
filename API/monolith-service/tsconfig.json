{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"rootDir": "./",
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@routes/*": ["./src/routes/*"],
			"@generated/*": ["./src/generated/*"]
		}
	},
	"include": ["src", "generated/grpc"],
	"exclude": ["node_modules"]
}
