// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Review {
  id              String   @id @default(uuid()) // id của review đó
  star            Int?
  comment         String   @db.Text // optional
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  acoommodationId String
  userId          String // user id của người đăng review
  // Self relation
  parentId        String?
  parent          Review?  @relation("ReviewToReplies", fields: [parentId], references: [id])
  replies         Review[] @relation("ReviewToReplies")
}
