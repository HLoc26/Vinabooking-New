{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"rootDir": "./",
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@prisma/client": ["generated/prisma/client"],
			"@src/*": ["src/*"]
		},
	},
	"include": ["src", "generated/grpc"],
	"exclude": ["node_modules", "generated"]
}
